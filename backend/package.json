{
  "name": "similator-equip-backend",
  "version": "1.0.0",
  "description": "装备强化模拟器后端服务 - MySQL + Redis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate-to-mysql.js",
    "docker:up": "cd .. && docker-compose up -d",
    "docker:down": "cd .. && docker-compose down",
    "docker:logs": "cd .. && docker-compose logs -f",
    "docker:reset": "cd .. && docker-compose down -v && docker-compose up -d"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "mysql2": "^3.6.0",
    "ioredis": "^5.3.0",
    "dotenv": "^16.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": ["game", "mysql", "redis", "express"],
  "author": "",
  "license": "MIT"
}
